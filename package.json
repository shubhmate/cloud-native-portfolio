{
  "name": "static-portfolio",
  "version": "1.6.0",
  "description": "A professional, high-performance static portfolio website built with HTML5, Tailwind CSS, and Vanilla JavaScript. Features comprehensive enhancements including dark/light theme toggle, toast notifications, and enhanced accessibility.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build:css"          : "npx tailwindcss -c tailwind.config.js -i ./src/styles/main.css -o ./dist/assets/css/main.css --minify",
    "build:js"           : "node automation/build.js",
    "build"              : "npm run build:js && npm run build:css",
    "fetch"              : "node automation/fetch-github.js",
    "dev"                : "npm run build && npx -y http-server dist",
    "deploy:aws"         : "DEPLOY_TARGET=aws node automation/deploy.js",
    "deploy:localstack"  : "DEPLOY_TARGET=localstack node automation/deploy.js",
    "localstack:start"   : "docker compose -f docker-compose.localstack.yml up -d",
    "localstack:stop"    : "docker compose -f docker-compose.localstack.yml down",
    "localstack:init"    : "node automation/localstack-init.js",
    "localstack:test"    : "npm run localstack:start && timeout 10 && npm run localstack:init && npm run deploy:localstack",
    "prepare"            : "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@aws-sdk/client-cloudfront": "^3.1038.0",
    "@aws-sdk/client-s3": "^3.1038.0",
    "autoprefixer": "^10.5.0",
    "dotenv": "^17.4.2",
    "htmlhint": "^1.9.2",
    "husky": "^9.1.7",
    "mime-types": "^3.0.2",
    "postcss": "^8.5.12",
    "tailwindcss": "^3.4.17"
  }
}
