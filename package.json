{
  "name": "cloud-native-portfolio",
  "version": "2.0.0",
  "description": "A professional, high-performance static portfolio website built with HTML5, Tailwind CSS, and Vanilla JavaScript. Features comprehensive enhancements including dark/light theme toggle, toast notifications, and enhanced accessibility.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "puppeteer": "^22.15.0"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "fetch": "node scripts/fetch-github.js",
    "dev": "npm run build && npx -y http-server dist",
    "deploy:aws": "cross-env DEPLOY_TARGET=aws node scripts/deploy.js",
    "deploy:localstack": "cross-env DEPLOY_TARGET=localstack node scripts/deploy.js",
    "localstack:start": "docker compose -f docker-compose.localstack.yml up -d",
    "localstack:stop": "docker compose -f docker-compose.localstack.yml down",
    "localstack:init": "node scripts/localstack-init.js",
    "localstack:test": "npm run localstack:start && timeout 10 && npm run localstack:init && npm run deploy:localstack",
    "lint:tf": "terraform -chdir=terraform fmt -check && cd terraform && tflint",
    "lint": "npm run lint:js",
    "lint:js": "eslint . --ext .js,.html",
    "type-check": "tsc",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@aws-sdk/client-cloudfront": "^3.1038.0",
    "@aws-sdk/client-s3": "^3.1038.0",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "autoprefixer": "^10.5.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.0",
    "eslint-plugin-html": "^8.1.4",
    "htmlhint": "^1.9.2",
    "husky": "^9.1.7",
    "mime-types": "^3.0.2",
    "postcss": "^8.5.12",
    "tailwindcss": "^3.4.17",
    "typescript": "^6.0.3"
  }
}
