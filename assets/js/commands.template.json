{
  "whoami": {
    "output": [
      "{{PERSON_NAME}}",
      "{{JOB_TITLE}} · {{YEARS_EXPERIENCE}}",
      "Status: {{CURRENT_STATUS}}",
      "Location: {{CURRENT_LOCATION}}"
    ],
    "color": "text-[var(--accent)]"
  },
  "about": {
    "output": [
      "Behind the Terminals:",
      "{{ABOUT_ME_DESCRIPTION}}"
    ],
    "color": "text-[var(--accent)]"
  },

  "skills": {
    "output": "{{TERMINAL_SKILLS}}",
    "color": "text-[var(--accent)]"
  },

  "projects": {
    "output": "{{TERMINAL_PROJECTS}}",
    "color": "text-[var(--accent)]"
  },

  "experience": {
    "output": [
      "{{EXP_1_ROLE}}        {{EXP_1_START}} – {{EXP_1_END}}",
      "{{EXP_2_ROLE}}   {{EXP_2_START}} – {{EXP_2_END}}"
    ],
    "color": "text-[var(--accent)]"
  },
  
  "contact": {
    "output": [
      "Email    → {{EMAIL_ADDRESS}}",
      "GitHub   → {{GITHUB_HANDLE}}",
      "LinkedIn → {{LINKEDIN_PROFILE}}"
    ],
    "color": "text-[var(--accent)]"
  },
  
  "build": {
    "output": [
      "Build Process:",
      "  1. Git push to main branch",
      "  2. GitHub Actions triggers workflow",
      "  3. ESLint + TypeScript validation",
      "  4. Terraform plans infrastructure",
      "  5. S3 deployment & CloudFront invalidation",
      "  6. Portfolio live!"
    ],
    "color": "text-[var(--accent)]"
  },

  "deploy": {
    "output": [
      "Deployment Steps:",
      "  Deploy to GitHub Pages: git push origin main",
      "  Deploy to Netlify: npm run build && netlify deploy",
      "  Deploy to AWS S3: aws s3 sync out/ s3://bucket",
      "  Invalidate CloudFront: aws cloudfront create-invalidation --distribution-id ID --paths '/*'"
    ],
    "color": "text-[var(--accent)]"
  },

  "email": {
    "output": "📧 Email: {{EMAIL_ADDRESS}}",
    "color": "text-blue-400"
  },

  "social": {
    "output": [
      "🔗 Social Links:",
      "  GitHub   → {{GITHUB_HANDLE}}",
      "  LinkedIn → {{LINKEDIN_PROFILE}}"
    ],
    "color": "text-purple-400"
  },

  "secret": {
    "output": [
      "🎉 You found the easter egg!",
      "Thanks for trying the terminal!",
      "Type 'help' for more commands."
    ],
    "color": "text-green-400"
  },

  "help": {
    "output": [
      "Available commands:",
      "  <b>whoami</b>    : About me",
      "  <b>about</b>     : Behind the Terminals",
      "  <b>skills</b>    : Tech stack",
      "  <b>projects</b>  : Featured work",
      "  <b>experience</b>: Work history",
      "  <b>contact</b>   : Get in touch",
      "  <b>build</b>     : Build process",
      "  <b>deploy</b>    : Deployment options",
      "  <b>email</b>     : Show email",
      "  <b>social</b>    : Show social links",
      "  <b>secret</b>    : Find the easter egg",
      "  <b>ssh</b>       : Connect to server (try 'ssh guest@shubham-mate')",
      "  <b>open</b>      : Go to section (e.g. 'open about')",
      "  <b>clear</b>     : Clear terminal"
    ],
    "color": "text-[var(--accent)]"
  },


  "clear": {
    "output": [],
    "color": "text-[var(--accent)]"
  },
  "ls": {
    "output": [
      "drwxr-xr-x  2 guest guest  4096 Apr 25 14:00 .",
      "drwxr-xr-x 22 root  root   4096 Apr 25 10:30 ..",
      "-rw-r--r--  1 guest guest   128 Apr 25 14:12 secret.txt",
      "-rw-r--r--  1 guest guest  1024 Apr 24 09:00 resume_draft.pdf"
    ],
    "color": "text-blue-400"
  },
  "cat": {
    "output": "Usage: cat [filename]",
    "color": "text-yellow-400"
  }
}
