# =============================================================================
# Deployment Environment Variables
# =============================================================================
# Copy this file to .env.deploy and fill in your values.
# .env.deploy is git-ignored — NEVER commit real credentials.
#
# Usage:
#   cp .env.deploy.example .env.deploy
#   # edit .env.deploy with your values
#   npm run deploy:aws
# =============================================================================

# ─── Deploy Target ─────────────────────────────────────────────────────────────
# Options: 'aws' or 'localstack'
DEPLOY_TARGET=aws

# ─── AWS Configuration ────────────────────────────────────────────────────────
AWS_REGION=us-east-1

# Your S3 bucket name (created by Terraform in Phase 2)
S3_BUCKET=shubhammate-portfolio

# Your CloudFront Distribution ID (from Terraform output or AWS console)
# Leave empty if CloudFront is not yet provisioned
CF_DIST_ID=

# ─── AWS Credentials ──────────────────────────────────────────────────────────
# Option A: Use AWS CLI profile (recommended — credentials stored in ~/.aws/)
#   Leave these empty and set AWS_PROFILE instead
AWS_PROFILE=default

# Option B: Explicit credentials (not recommended for local dev)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ─── LocalStack (for local testing only) ──────────────────────────────────────
# These are only used when DEPLOY_TARGET=localstack
# LocalStack uses fake credentials — these values are intentionally 'test'
LOCALSTACK_ENDPOINT=http://localhost:9000
